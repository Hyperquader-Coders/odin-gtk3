# odin-gtk3: its place in the binding graph
# Render:  d2 diags/odin-gtk3.d2 diags/odin-gtk3.svg

direction: down

title: "odin-gtk3" {
  shape: text
  near: top-center
  style.font-size: 28
  style.bold: true
}

this: "odin-gtk3\nGTK 3 and GDK 3 3.24.41, ATK 2.52.0" {
  style.fill: "#eef6ff"
}
lib: "gtk+-3.0 (shared library)" {
  style.fill: "#fff6e6"
}
consumers: "every other binding and every app\nimport \"gtk3:<pkg>\"" {
  style.fill: "#f2f2f2"
}

consumers -> this: collection gtk3
this -> lib: foreign import
